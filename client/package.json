{
  "name": "delta-finance-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Delta Finance SPA (React + TypeScript + Vite)",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "openapi:lint": "redocly lint ../specs/001-finance/contracts/openapi.yaml",
    "openapi:types": "openapi-typescript ../specs/001-finance/contracts/openapi.yaml -o src/lib/api/schema.d.ts",
    "prebuild": "npm run openapi:lint && npm run openapi:types",
    "pretypecheck": "npm run openapi:types",
    "openapi:check": "npm run openapi:lint && npm run openapi:types && git diff --exit-code -- src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.87.0",
    "react-router": "8.5.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@redocly/cli": "2.71.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.0",
    "axe-core": "4.12.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.0",
    "globals": "17.0.0",
    "jsdom": "28.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.11"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
