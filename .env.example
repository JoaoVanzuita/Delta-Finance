# Delta Finance — exemplo de configuração.
#
# Copie para `.env` e preencha com valores locais. NUNCA versione `.env`,
# dumps, backups ou o key ring. Os valores abaixo são placeholders sem valor
# operacional e devem ser trocados antes de qualquer uso real.

# --- Banco de dados (serviço `db` do Compose) ---
DELTA_DB_NAME=delta_finance
DELTA_DB_USER=delta
DELTA_DB_PASSWORD=troque-esta-senha-local
DELTA_DB_PORT=5432
DELTA_DB_POOL_SIZE=10

# --- Aplicação / domínio público ---
DELTA_DOMAIN=localhost
DELTA_PUBLIC_BASE_URL=https://localhost
DELTA_ACME_EMAIL=voce@example.com
DELTA_COOKIE_SECURE=true
DELTA_SERVER_PORT=8080

# --- Criptografia (key ring externo, montado read-only) ---
# Gere chaves com `openssl rand -base64 32` e crie secrets/crypto-keys.json
# conforme deploy/README.md. Sem o key ring os dados cifrados são irrecuperáveis.
DELTA_CRYPTO_KEY_FILE=/run/secrets/crypto-keys.json
# GID do arquivo secrets/crypto-keys.json no host (stat -c %g).
DELTA_KEYRING_GID=1000
DELTA_CRYPTO_ACTIVE_VERSION=1
DELTA_INDEX_KEY_VERSION=1

# --- Integração Pluggy (Meu Pluggy pessoal) ---
# Credenciais NÃO ficam aqui: cada usuário informa Client ID/Secret na própria
# conta. Estas variáveis apenas configuram o comportamento do servidor.
DELTA_PLUGGY_BASE_URL=https://api.pluggy.ai
DELTA_PLUGGY_WEBHOOKS_ENABLED=false
DELTA_PLUGGY_CONNECTION_LIMIT=5
DELTA_PLUGGY_CONNECTION_LIMIT_CHECKED_AT=2026-10-22

# --- Backup (retenção em dias) ---
DELTA_BACKUP_RETENTION_DAYS=30

# --- Frontend (apenas desenvolvimento local) ---
VITE_API_PROXY_TARGET=http://localhost:8080
