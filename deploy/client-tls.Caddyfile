{
	# TLS interno para LAN; endpoint administrativo desabilitado.
	admin off
	# A confiança da CA é feita nos dispositivos, não no container.
	skip_install_trust
	# Navegadores e curl não enviam SNI ao acessar um IP literal (RFC 6066);
	# o Caddy usaria ServerName vazio e não escolheria o certificado. O valor
	# precisa ser o mesmo de DELTA_LAN_HOST (o IP fixo do host).
	default_sni {$DELTA_LAN_HOST}
}

# Entrada HTTP: healthcheck interno e redirect para HTTPS.
:8080 {
	handle /healthz {
		respond "ok" 200
	}

	handle {
		redir https://{http.request.host}{uri} 308
	}
}

https://{$DELTA_LAN_HOST}:8443 {
	tls internal
	encode zstd gzip

	# O backend já envia HSTS nas respostas da API; a borda cobre os assets e
	# o HTML para que a origem inteira tenha o header.
	@static not path /api/*
	header @static Strict-Transport-Security "max-age=31536000; includeSubDomains"

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		-Server
	}

	# Assets com hash no nome podem ser cacheados agressivamente; o HTML nunca.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-store"
	header / Cache-Control "no-store"

	handle /api/* {
		reverse_proxy server:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
