# Delta Finance — configuração do release self-hosted.
#
# Copie para `.env` e troque pelo menos DELTA_DB_PASSWORD. Nunca versione o
# `.env` real, o key ring ou backups.

# --- Versão e imagens ---
# A versão é a tag publicada no GHCR, sem o prefixo "v" (ex.: 0.1.0).
DELTA_VERSION=0.1.0
# Owner do GitHub que publicou as imagens. O workflow de release ajusta este
# valor no kit distribuído.
DELTA_IMAGE_OWNER=joaovanzuita

# --- Banco de dados ---
DELTA_DB_NAME=delta_finance
DELTA_DB_USER=delta
# Use uma senha longa e sem caracteres problemáticos para .env. Depois da
# primeira subida, alterar esta variável não muda a senha já gravada no volume;
# para trocar, use ALTER USER no PostgreSQL.
DELTA_DB_PASSWORD=troque-esta-senha-local
DELTA_DB_POOL_SIZE=10

# --- Acesso na LAN ---
# Porta publicada no host. O backend e o banco não são publicados.
LAN_PORT=8080

# --- Key ring ---
# GID do arquivo secrets/crypto-keys.json no host Linux. No Windows, o Docker
# Desktop normalmente consegue ler o arquivo; ajuste apenas se necessário.
DELTA_KEYRING_GID=1000
DELTA_CRYPTO_ACTIVE_VERSION=1
DELTA_INDEX_KEY_VERSION=1

# --- Recursos ---
# Limite de memória do backend. Ajuste conforme a RAM do mini PC.
DELTA_SERVER_MEM_LIMIT=1g

# --- Opcionais: recuperação assistida e rotação ---
DELTA_OPERATOR_RESET_TOKEN=
DELTA_KEY_ROTATION_RUN=false

# --- Opcionais: Pluggy e sincronização ---
DELTA_PLUGGY_BASE_URL=https://api.pluggy.ai
DELTA_PLUGGY_CONNECTION_LIMIT=5
DELTA_PLUGGY_CONNECTION_LIMIT_CHECKED_AT=2026-10-22
DELTA_SYNC_SCHEDULER_ENABLED=true
DELTA_SYNC_SCHEDULER_INTERVAL=1m
DELTA_SYNC_DAILY_WINDOW_DAYS=7
DELTA_SYNC_INITIAL_WINDOW_MONTHS=12
DELTA_SYNC_RECONCILIATION_WINDOW_MONTHS=12
DELTA_SYNC_RECONCILIATION_DAY=1
DELTA_SYNC_JITTER=60s
DELTA_SYNC_MAX_ATTEMPTS=5
DELTA_SYNC_BATCH_SIZE=10
